# QueryPilot Environment Configuration

# Database Configuration (Oracle Database Free / Express / Enterprise)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_USER=qp_app_user
ORACLE_PASSWORD=qp_app_password
ORACLE_ADMIN_USER=system
ORACLE_ADMIN_PASSWORD=oracle_password
ORACLE_CONNECT_TIMEOUT_SEC=5

# Safety Guardrails
MAX_EXECUTION_TIME_SEC=30
MAX_ROWS_RETURNED=1000
MAX_RESPONSE_SIZE_BYTES=5242880
ALLOW_OFFLINE_SIMULATION=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
ENVIRONMENT=development
LOG_LEVEL=INFO
